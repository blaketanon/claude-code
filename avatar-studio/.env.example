# --- LLM: any OpenAI-compatible server (Ollama, vLLM, llama.cpp llama-server, LM Studio, LocalAI) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
# LLM_API_KEY=                  # only if your server requires one
# LLM_TEMPERATURE=0.8
# LLM_MAX_TRANSCRIPT_CHARS=16000 # raise if your model has a big context window

# --- Voice: the bundled voice-server (faster-whisper + Chatterbox) ---
VOICE_SERVER_URL=http://localhost:8000
# VOICE_SERVER_API_KEY=         # must match the voice server's VOICE_SERVER_API_KEY
# STT_BASE_URL=                 # optional: separate OpenAI-compatible /v1/audio/transcriptions server
# STT_MODEL=whisper-1

# --- Optional: hosted lip-sync video (D-ID). Without it the portrait animates to the audio. ---
DID_API_KEY=

# PORT=3000
# DATA_DIR=./data
# MAX_UPLOAD_MB=500
# DEMO_MODE=1   # force offline fallbacks
