# Local development: copy to .env and `set -a; source .env; set +a`.
SECRET_KEY=change-me
ADMIN_PASSWORD=pick-something-long            # signs in to the admin page at /
SALESFORCE_API_KEY=generate-a-long-random-key # the Named Credential sends this as X-Api-Key
PUBLIC_URL=http://127.0.0.1:5056
# DATABASE_URL=postgresql://user:pass@localhost:5432/gero_trace   # default: SQLite in ./instance

# Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
INVESTIGATION_BUDGET_USD=8
INVESTIGATION_MAX_TURNS=80
FIX_BUDGET_USD=15
FIX_MAX_TURNS=120
# CLAUDE_CODE_USE_BEDROCK=1   # alternative to the API key: use the AWS account's Bedrock access

# GitHub (either a GitHub App installed on the FundingMetrics org — preferred — or a PAT)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=       # PEM contents, newlines as \n
# GITHUB_TOKEN=ghp_...
GITHUB_ISSUES_REPO=FundingMetrics/gero-trace   # where reports are filed as issues
GITHUB_WEBHOOK_SECRET=another-long-random-string
GITHUB_APPROVE_LABEL=approved-for-fix
GITHUB_DEFAULT_ASSIGNEE=blaketanon

# Salesforce read-only access for the investigator (JWT bearer flow, a Connected App + integration user)
SF_USERNAME=claude.trace@fundingmetrics.com
SF_CLIENT_ID=
SF_JWT_KEY=                   # PEM contents of the connected app's private key, newlines as \n
SF_LOGIN_URL=https://login.salesforce.com

# Where repos and Salesforce metadata are cached on disk for the investigator
WORKSPACE_DIR=./workspace
SYSTEMS_FILE=./config/systems.yaml
REPO_SYNC_MINUTES=30
SF_METADATA_SYNC_MINUTES=180
