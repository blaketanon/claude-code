# ---- Core ----
ALPHAFORGE_ENV=dev
ALPHAFORGE_DATA_DIR=./data
ALPHAFORGE_DB_URL=sqlite:///./data/alphaforge.db
ALPHAFORGE_SECRET_KEY=change-me-to-a-long-random-string
ALPHAFORGE_ADMIN_USER=admin
ALPHAFORGE_ADMIN_PASSWORD=change-me

# ---- Trading mode: paper | live  (live requires ALPHAFORGE_LIVE_TRADING_ACK=I_UNDERSTAND_THE_RISK) ----
ALPHAFORGE_TRADING_MODE=paper
ALPHAFORGE_LIVE_TRADING_ACK=

# ---- Broker (Alpaca) ----
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# ---- Market data provider: synthetic | yfinance | alpaca ----
ALPHAFORGE_DATA_PROVIDER=yfinance

# ---- AI analyst (Claude). Leave blank to disable LLM features. ----
ANTHROPIC_API_KEY=
ALPHAFORGE_LLM_MODEL=claude-opus-5-5

# ---- Universe & cadence ----
ALPHAFORGE_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,AMD,META,AMZN,GOOGL
ALPHAFORGE_TIMEFRAME=5m
